{
  "name": "PHS-DS-Knowledge-Base",
  "version": "3.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nuxt",
    "build": "nuxt build",
    "start": "nuxt start",
    "generate": "nuxt generate",
    "lint": "npm run lint:js && npm run lint:styles && npm run format:check",
    "lint:js": "eslint .",
    "lint:styles": "stylelint \"**/*.{css,scss,vue}\"",
    "lint:changed": "node scripts/lint-changed.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@nuxtjs/axios": "^5.12.5",
    "babel-runtime": "^6.26.0",
    "bootstrap": "^4.6.2",
    "bootstrap-vue": "^2.23.1",
    "eva-icons": "^1.1.3",
    "nuxt": "^2.15.8",
    "sass": "^1.58.3",
    "sass-loader": "^10.1.1",
    "vue-analytics": "^5.22.1",
    "vue-eva-icons": "^1.1.1",
    "vue-markdown": "^2.1.2",
    "vue-multiselect": "^2.1.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "vitest": "^3.2.7"
